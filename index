<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mohammad Mosallaei · Architect & BIM Professional</title>
  <!-- Font Awesome Icons (free) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #f4f7fb;
      font-family: 'Segoe UI', Roboto, system-ui, -apple-system, sans-serif;
      display: flex;
      justify-content: center;
      padding: 2rem 1rem;
      line-height: 1.6;
      color: #1e2b3c;
    }

    .portfolio {
      max-width: 1200px;
      width: 100%;
      background: white;
      border-radius: 2rem;
      box-shadow: 0 20px 40px -12px rgba(0, 20, 30, 0.25);
      padding: 2.5rem 2.8rem;
      transition: all 0.2s;
    }

    @media (max-width: 700px) {
      .portfolio {
        padding: 1.8rem 1.2rem;
      }
    }

    /* header / avatar row */
    .profile-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1.5rem 2rem;
      margin-bottom: 2rem;
      border-bottom: 2px solid #eef2f6;
      padding-bottom: 2rem;
    }

    .avatar {
      background: linear-gradient(145deg, #1e2b3c, #2c3e50);
      width: 100px;
      height: 100px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 2.8rem;
      font-weight: 500;
      box-shadow: 0 8px 16px rgba(0,0,0,0.1);
      flex-shrink: 0;
    }

    .title-group h1 {
      font-size: 2.2rem;
      font-weight: 600;
      letter-spacing: -0.5px;
      color: #0b1a26;
    }

    .title-group h3 {
      font-weight: 400;
      color: #2c4a5e;
      margin-top: 0.2rem;
      font-size: 1.2rem;
    }

    .badge-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 0.8rem;
      margin-top: 0.7rem;
    }

    .badge-strip a {
      text-decoration: none;
    }

    .badge-strip img {
      height: 28px;
      border-radius: 6px;
      transition: 0.2s;
    }

    .badge-strip img:hover {
      transform: scale(1.02);
      filter: brightness(0.95);
    }

    /* summary */
    .summary {
      background: #f0f5fa;
      padding: 1.6rem 2rem;
      border-radius: 1.5rem;
      margin-bottom: 2.2rem;
      border-left: 6px solid #2c6b8f;
    }

    .summary p {
      font-size: 1.05rem;
      color: #1a2e3d;
    }

    /* grid layout */
    .grid-2col {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 2.2rem;
      margin-bottom: 2.5rem;
    }

    @media (max-width: 850px) {
      .grid-2col {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }

    .card {
      background: #f9fcff;
      border-radius: 1.5rem;
      padding: 1.5rem 1.8rem;
      box-shadow: 0 4px 12px rgba(0, 20, 30, 0.05);
      border: 1px solid #eaf0f5;
      transition: 0.2s;
    }

    .card:hover {
      border-color: #cbdae6;
      box-shadow: 0 8px 18px rgba(0, 20, 30, 0.06);
    }

    .card h2 {
      font-size: 1.3rem;
      font-weight: 600;
      color: #1e3b4f;
      margin-bottom: 1.2rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      border-bottom: 2px solid #e3ebf2;
      padding-bottom: 0.6rem;
    }

    .card h2 i {
      color: #2c6b8f;
      font-size: 1.2rem;
      width: 1.6rem;
    }

    .skill-tag {
      display: inline-block;
      background: white;
      border: 1px solid #d6e2ec;
      border-radius: 40px;
      padding: 0.3rem 1rem;
      margin: 0.25rem 0.3rem 0.25rem 0;
      font-size: 0.9rem;
      font-weight: 500;
      color: #1b3b4f;
      transition: 0.1s;
    }

    .skill-tag i {
      color: #2c6b8f;
      margin-right: 0.3rem;
      font-size: 0.8rem;
    }

    .skill-group-title {
      font-weight: 600;
      color: #1f4057;
      margin: 0.8rem 0 0.3rem 0;
      font-size: 0.95rem;
      letter-spacing: 0.3px;
    }

    .exp-item {
      margin-bottom: 1.4rem;
    }

    .exp-item strong {
      color: #0b2a3d;
      font-size: 1.05rem;
    }

    .exp-item .meta {
      font-weight: 500;
      color: #3a637c;
      font-size: 0.9rem;
      display: block;
      margin: 0.1rem 0 0.3rem 0;
    }

    .exp-item ul {
      list-style: none;
      padding-left: 0.2rem;
      margin-top: 0.3rem;
    }

    .exp-item ul li {
      padding: 0.2rem 0 0.2rem 1.4rem;
      position: relative;
      font-size: 0.95rem;
    }

    .exp-item ul li::before {
      content: "▹";
      position: absolute;
      left: 0;
      color: #2c6b8f;
      font-weight: 600;
    }

    .education-box {
      background: #eaf2f8;
      border-radius: 1rem;
      padding: 1rem 1.4rem;
      margin: 0.8rem 0 0.2rem 0;
    }

    .target-roles {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 0.6rem;
      margin-top: 0.8rem;
    }

    .target-roles span {
      background: white;
      border-radius: 30px;
      padding: 0.2rem 1.2rem;
      border: 1px solid #cbdae6;
      font-size: 0.85rem;
      font-weight: 500;
    }

    .contact-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.2rem 1.8rem;
      margin: 1.5rem 0 0.2rem;
      padding-top: 1.2rem;
      border-top: 2px solid #e2ebf3;
    }

    .contact-links a {
      text-decoration: none;
      color: #1e3b4f;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: 0.15s;
      border-radius: 30px;
      padding: 0.3rem 0.8rem;
      background: #f2f7fc;
    }

    .contact-links a i {
      font-size: 1.1rem;
      color: #2c6b8f;
    }

    .contact-links a:hover {
      background: #e2edf7;
      color: #0b2a3d;
      transform: translateY(-2px);
    }

    .footer-note {
      text-align: center;
      margin: 2rem 0 0.2rem;
      font-size: 0.95rem;
      color: #3a5b70;
    }

    .footer-note i {
      color: #c44545;
    }

    hr {
      border: 0;
      border-top: 2px solid #e5eef6;
      margin: 0.5rem 0 1.2rem;
    }

    /* small */
    @media (max-width: 480px) {
      .avatar {
        width: 70px;
        height: 70px;
        font-size: 2rem;
      }
      .title-group h1 {
