      // just to show minimal js interaction, we add a tiny effect on card titles
      const cards = document.querySelectorAll('.card h2');
      cards.forEach((h2) => {
        h2.addEventListener('mouseenter', function(e) {
          this.style.transition = '0.15s';
          this.style.color = '#1f5777';
